# TravelBucks Voice Ops API - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# CASPIO DATABASE
# =============================================================================

# Your Caspio account base URL (e.g., https://***REMOVED***.caspio.com)
CASPIO_BASE_URL=https://***REMOVED***.caspio.com

# OAuth token endpoint
CASPIO_TOKEN_URL=https://***REMOVED***.caspio.com/oauth/token

# OAuth credentials (from Caspio > Account > Web Services)
CASPIO_CLIENT_ID=your_client_id_here
CASPIO_CLIENT_SECRET=your_client_secret_here

# Table name for leads (default: TravelBucks_Leads)
CASPIO_TABLE_LEADS=TravelBucks_Leads

# =============================================================================
# RETELL AI
# =============================================================================

# Your Retell API key
RETELL_API_KEY=your_retell_api_key_here

# =============================================================================
# PAYMENT
# =============================================================================

# Base URL for Caspio payment DataPage
# This is where users are sent to complete payment
PAYMENT_PAGE_BASE_URL=https://***REMOVED***.caspio.com/dp/your_datapage_id

# =============================================================================
# SECURITY
# =============================================================================

# Secret for webhook authentication
# Generate with: openssl rand -hex 32
APP_SECRET=generate_a_secure_random_string_here

# =============================================================================
# SERVER
# =============================================================================

# Port to run the server on (Railway sets this automatically)
PORT=3000

# Environment (development, production)
NODE_ENV=development
